<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 🔓 DEBUG BUILD: Trust user-installed certificates -->
    <!-- Allows Burp Suite, OWASP ZAP, Frida to intercept HTTPS traffic in debug mode -->
    <debug-overrides>
        <trust-anchors>
            <!-- User-installed certificates (Burp Suite CA, custom CAs) -->
            <certificates src="user" />
            <!-- System certificates (default Android CA store) -->
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- 🔒 PRODUCTION BUILD: Maximum security -->
    <!-- Default: Only trust system certificates, reject cleartext HTTP for public domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Only system certificates trusted -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 🌐 WHITELIST LOCAL IP & DOMAIN: Explicitly permit HTTP for local development & testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.5.50.107</domain>
    </domain-config>
</network-security-config>
